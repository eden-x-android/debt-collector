# Supabase Postgres connection string (free tier)
# Get it from: Supabase project > Connect > ORMs > Prisma
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Resend API key (free tier, 100 emails/day) — https://resend.com
RESEND_API_KEY=""

# Hardcoded login (single-user)
ADMIN_USERNAME="admin"
OTP_RECIPIENT_EMAIL=""

# Secret used to sign the session JWT — generate with: openssl rand -base64 32
SESSION_SECRET=""
