# ── Database (Supabase Postgres — free tier) ─────────────────────────────
# Trên Supabase bấm "Connect" → chọn tab tương ứng, copy chuỗi URI:
#
# DATABASE_URL  ← tab "Transaction pooler" (port 6543, host *.pooler.supabase.com)
#                 dùng cho app runtime (serverless/Vercel), IPv4.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL    ← tab "Direct connection" (port 5432) — dùng cho `prisma db push`/migrate.
#                 Nếu mạng chỉ có IPv4 và Direct bị timeout, thay bằng chuỗi
#                 tab "Session pooler" (IPv4, port 5432).
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Session / Auth ───────────────────────────────────────────────────────
# Sinh bằng: openssl rand -base64 32  (hoặc: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SESSION_SECRET="thay-bang-chuoi-ngau-nhien-32-byte"

# ── Email OTP (Resend — free 100 email/ngày) ─────────────────────────────
# Tạo API key tại https://resend.com/api-keys
RESEND_API_KEY=""
# Địa chỉ gửi. Mặc định onboarding@resend.dev dùng được ngay (chỉ gửi tới email chủ tài khoản Resend).
OTP_EMAIL_FROM="Debt Collector <onboarding@resend.dev>"
